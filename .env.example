# Copy this file to .env and fill in your real values. Never commit .env.

# From your Twilio Console (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you bought, in E.164 format
TWILIO_FROM_NUMBER=+12085550100

# Josh's cell phone, in E.164 format
JOSH_CELL_NUMBER=+12085550199

# Any random long string — used to sign Flask's session cookie
SECRET_KEY=change-me-to-something-random
